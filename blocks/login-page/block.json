{
    "apiVersion": 3,
    "name": "jankx/login-page",
    "title": "Login Page",
    "category": "jankx",
    "icon": "lock",
    "editorScript": "file:./build/index.js",
    "style": "file:./build/style-index.css",
    "attributes": {
        "backgroundImage": {
            "type": "string",
            "default": ""
        },
        "backgroundImageId": {
            "type": "number",
            "default": 0
        },
        "pageType": {
            "type": "string",
            "default": "login",
            "enum": [
                "login",
                "register"
            ]
        },
        "brandName": {
            "type": "string",
            "default": "NOBITOUR"
        },
        "brandColor": {
            "type": "string",
            "default": "#65A30D"
        }
    },
    "supports": {
        "html": false,
        "align": [
            "full"
        ],
        "spacing": {
            "margin": true,
            "padding": true
        }
    }
}