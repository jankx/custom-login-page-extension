{
    "apiVersion": 3,
    "name": "jankx/register-form",
    "title": "Register Form",
    "category": "jankx",
    "icon": "forms",
    "editorScript": "file:./build/index.tsx.js",
    "parent": ["jankx/login-page"],
    "attributes": {
        "brandName": {
            "type": "string",
            "default": "NOBITOUR"
        },
        "brandColor": {
            "type": "string",
            "default": "#65A30D"
        },
        "showPhoneField": {
            "type": "boolean",
            "default": true
        },
        "showTermsCheckbox": {
            "type": "boolean",
            "default": true
        },
        "termsPageUrl": {
            "type": "string",
            "default": ""
        },
        "loginPageUrl": {
            "type": "string",
            "default": ""
        },
        "contactUrl": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false,
        "spacing": {
            "margin": true,
            "padding": true
        }
    }
}
